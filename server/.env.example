# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

# Backend port. The client expects 5001.
PORT=5001

# MongoDB connection. Local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017/smartbin

# Secret used to sign login tokens. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Gemini API key (used only when AI_PROVIDER=gemini).
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary credentials for photo uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI provider: "gemini" (default) or "local" (our own YOLO11 model).
AI_PROVIDER=gemini

# Local model service (ml/service). Required when AI_PROVIDER=local.
ML_SERVICE_URL=http://localhost:8000

# Local model version to use, e.g. v1. Optional; the ML service default applies if unset.
ML_MODEL_VERSION=v1
